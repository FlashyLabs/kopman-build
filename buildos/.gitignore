node_modules
.next
.turbo
dist
*.env
# `.env.vercel` did not match `*.env` — that pattern needs the name to END in
# .env, and this one ends in .vercel. Six days and seven live credentials went
# into the repository through that gap on 2026-08-23. `.env.*` closes it.
.env.*
!.env.example
!.env.sample
.env.local
.env.production
# `*.env` matches a file ending in .env; it does not match `.env.vercel`,
# which is how a real AUTH_SECRET reached a tracked file. Match the family.
.env.*
!.env.example
.vercel
