# ── REQUIRED FOR BUILD ────────────────────────────────────────────────────
# next-auth signing key — already generated, copy this value as-is
AUTH_SECRET=4yxz0TGJ9x82qdQ5gMtphn8R34XTWfYwt1efIwU66Mo=

# Set this to your Vercel preview URL after first deploy, e.g.:
# NEXTAUTH_URL=https://buildos-xyz.vercel.app
NEXTAUTH_URL=https://buildos.vercel.app

# ── REQUIRED TO LOG IN ────────────────────────────────────────────────────
# Get these from FlashyID — your OIDC app credentials
FLASHY_ID_ISSUER=https://id.flashylabs.xyz
FLASHY_ID_CLIENT_ID=
FLASHY_ID_CLIENT_SECRET=

# ── REQUIRED FOR ANY DATA ─────────────────────────────────────────────────
# Recommended: Neon (neon.tech) — free tier, Postgres, works great with Vercel
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
DATABASE_URL_MIGRATOR=   # same as DATABASE_URL for Neon (already superuser)

# ── REQUIRED FOR AI FEATURES ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── REQUIRED FOR MEDIA UPLOADS ────────────────────────────────────────────
# Cloudflare R2 — free 10GB, zero egress fees
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=buildos-media
R2_PUBLIC_URL=   # e.g. https://pub-xxxx.r2.dev (enable public access on bucket)

# ── REQUIRED FOR EMAIL ────────────────────────────────────────────────────
# resend.com — free tier 3k emails/month
RESEND_API_KEY=
EMAIL_FROM=Kopman Build <hello@kopman.build>

# ── REQUIRED FOR BILLING ──────────────────────────────────────────────────
# stripe.com — use test keys (sk_test_...) for preview
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=   # from Stripe Dashboard → Webhooks → your endpoint
STRIPE_PRICE_STARTER=    # price_... from Stripe Dashboard
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# ── OPTIONAL (social publishing) ──────────────────────────────────────────
META_IG_BUSINESS_ID=
META_FB_PAGE_ID=
META_ACCESS_TOKEN=
GOOGLE_LOCATION_ID=
GOOGLE_ACCESS_TOKEN=

# ── OPTIONAL (video quote worker) ─────────────────────────────────────────
FRAME_WORKER_URL=
FRAME_WORKER_SECRET=
