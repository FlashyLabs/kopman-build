# Template only. Every value below is intentionally blank.
#
# This file previously carried a real generated AUTH_SECRET, which made it a
# committed credential in a tracked file — the exact thing the estate's
# secret-scan workflow exists to catch, and which it names in its own header.
# Blanking it here removes it from the working tree; it does NOT remove it from
# git history, so the value it held must be treated as disclosed and rotated.
#
# Generate a new signing key with:  openssl rand -base64 32
# Set real values in the Vercel dashboard, never in a file in this repository.
#
# ── REQUIRED FOR BUILD ────────────────────────────────────────────────────
# next-auth signing key — already generated, copy this value as-is
AUTH_SECRET=

# Set this to your Vercel preview URL after first deploy, e.g.:
# NEXTAUTH_URL=https://buildos-xyz.vercel.app
NEXTAUTH_URL=

# ── REQUIRED TO LOG IN ────────────────────────────────────────────────────
# Get these from FlashyID — your OIDC app credentials
FLASHY_ID_ISSUER=
FLASHY_ID_CLIENT_ID=
FLASHY_ID_CLIENT_SECRET=

# ── REQUIRED FOR ANY DATA ─────────────────────────────────────────────────
# Recommended: Neon (neon.tech) — free tier, Postgres, works great with Vercel
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
DATABASE_URL_MIGRATOR=

# ── REQUIRED FOR AI FEATURES ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── REQUIRED FOR MEDIA UPLOADS ────────────────────────────────────────────
# Cloudflare R2 — free 10GB, zero egress fees
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── REQUIRED FOR EMAIL ────────────────────────────────────────────────────
# resend.com — free tier 3k emails/month
RESEND_API_KEY=
EMAIL_FROM=

# ── REQUIRED FOR BILLING ──────────────────────────────────────────────────
# stripe.com — use test keys (sk_test_...) for preview
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# ── OPTIONAL (social publishing) ──────────────────────────────────────────
META_IG_BUSINESS_ID=
META_FB_PAGE_ID=
META_ACCESS_TOKEN=
GOOGLE_LOCATION_ID=
GOOGLE_ACCESS_TOKEN=

# ── OPTIONAL (video quote worker) ─────────────────────────────────────────
FRAME_WORKER_URL=
FRAME_WORKER_SECRET=
